# Copy this file to .env and fill in your own values.
# .env is gitignored. Never commit real keys or local paths.

# Personal API key from Tankerkönig (tankerkoenig.de)
TANKERKOENIG_API_KEY=your-api-key-here

# Absolute path to your local copy of the Tankerkönig history archive.
# Must be OUTSIDE this repository.
DATA_DIR=/path/to/tankerkoenig-history-archive
